---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseAdmin, db } from '../../../lib/supabase';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/skills');

const admin = createSupabaseAdmin();
let formError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const skills = (form.get('skills') as string)
    .split(',').map(s => s.trim()).filter(Boolean);

  const { error } = await db(admin).from('skill_groups').update({
    category: form.get('category') as string,
    skills,
    lang: form.get('lang') as string,
    display_order: parseInt(form.get('display_order') as string) || 0,
  }).eq('id', id);

  if (error) formError = error.message;
  else return Astro.redirect('/admin/skills');
}

const { data: group } = await db(admin).from('skill_groups').select('*').eq('id', id).single();
if (!group) return Astro.redirect('/admin/skills');
---

<AdminLayout title="Edit Skill Group" breadcrumb={`skills / ${group.category}`}>
  <div style="max-width:680px;">
    <div class="page-header">
      <h1 class="page-title">Edit skill group</h1>
      <a href="/admin/skills" class="btn-secondary" style="text-decoration:none;">← Back</a>
    </div>

    {formError && <div class="error-alert">{formError}</div>}

    <form method="POST" class="form-section">
      <div class="form-row-2">
        <div class="form-group">
          <label for="category">Category *</label>
          <input type="text" id="category" name="category" required value={group.category} />
        </div>
        <div class="form-row-2" style="gap:12px;">
          <div class="form-group">
            <label for="lang">Language</label>
            <select name="lang" id="lang">
              <option value="en" selected={group.lang === 'en'}>EN</option>
              <option value="es" selected={group.lang === 'es'}>ES</option>
            </select>
          </div>
          <div class="form-group">
            <label for="display_order">Order</label>
            <input type="number" name="display_order" id="display_order" value={group.display_order} min="0" />
          </div>
        </div>
      </div>

      <div class="form-group">
        <label for="skills">Skills (comma-separated) *</label>
        <textarea id="skills" name="skills" rows="4" required>{group.skills?.join(', ')}</textarea>
      </div>

      <div style="display:flex; gap:12px;">
        <button type="submit" class="btn-primary">Save changes</button>
        <a href="/admin/skills" class="btn-secondary" style="text-decoration:none;">Cancel</a>
      </div>
    </form>
  </div>
</AdminLayout>
