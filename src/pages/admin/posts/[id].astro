---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseAdmin, db, estimateReadingTime, slugify } from '../../../lib/supabase';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/posts');

const admin = createSupabaseAdmin();
let formError: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  const title = formData.get('title') as string;
  const content = formData.get('content') as string;
  const customSlug = (formData.get('slug') as string).trim();
  const slug = customSlug || slugify(title);

  const { error } = await db(admin).from('posts').update({
    title,
    slug,
    summary: formData.get('summary') as string,
    content,
    published: formData.get('published') === 'on',
    reading_time: estimateReadingTime(content),
  }).eq('id', id);

  if (error) {
    formError = error.message;
  } else {
    return Astro.redirect('/admin/posts');
  }
}

const { data: post, error: fetchError } = await db(admin)
  .from('posts')
  .select('*')
  .eq('id', id)
  .single();

if (fetchError || !post) return Astro.redirect('/admin/posts');
---

<AdminLayout title="Edit Post" breadcrumb={`posts / ${post.title}`}>
  <div style="max-width: 780px;">
    <div class="page-header">
      <h1 class="page-title">Edit post</h1>
      <div style="display: flex; gap: 10px; align-items: center;">
        {post.published && (
          <a href={`/blog/${post.slug}`} target="_blank" class="btn-ghost" style="text-decoration: none; font-size: 0.75rem; padding: 6px 14px;">
            ↗ View post
          </a>
        )}
        <a href="/admin/posts" class="btn-secondary" style="text-decoration: none;">← Back</a>
      </div>
    </div>

    {formError && (
      <div class="error-alert">{formError}</div>
    )}

    <form method="POST">
      <!-- Core fields -->
      <div class="form-section">
        <div class="form-section-title">Post details</div>

        <div class="form-group">
          <label for="title">Title *</label>
          <input type="text" id="title" name="title" required value={post.title} />
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="slug">Slug</label>
            <input type="text" id="slug" name="slug" value={post.slug} style="font-family: var(--font-mono); font-size: 0.8rem;" />
          </div>
          <div class="form-group" style="display: flex; align-items: flex-end; padding-bottom: 20px;">
            <label class="checkbox-label" style="margin: 0;">
              <input type="checkbox" name="published" checked={post.published} />
              Published
            </label>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="summary">Summary *</label>
          <textarea id="summary" name="summary" required rows="2">{post.summary}</textarea>
        </div>
      </div>

      <!-- Content -->
      <div class="form-section">
        <div class="form-section-title">Content</div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="content">Markdown *</label>
          <textarea
            id="content"
            name="content"
            required
            rows="28"
            style="font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.65;"
          >{post.content}</textarea>
          <p class="helper-text">
            ~{post.reading_time} min read &middot; last saved {new Date(post.updated_at).toLocaleDateString()}
          </p>
        </div>
      </div>

      <!-- Actions -->
      <div style="display: flex; gap: 12px; align-items: center;">
        <button type="submit" class="btn-primary">Save changes</button>
        <a href="/admin/posts" class="btn-secondary" style="text-decoration: none;">Cancel</a>
      </div>
    </form>
  </div>
</AdminLayout>
