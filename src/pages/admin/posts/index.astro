---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseAdmin, db } from '../../../lib/supabase';

const admin = createSupabaseAdmin();

// Handle POST (delete / toggle publish)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;
  const id = formData.get('id') as string;

  if (id) {
    if (action === 'delete') {
      await db(admin).from('posts').delete().eq('id', id);
    } else if (action === 'publish') {
      await db(admin).from('posts').update({ published: true }).eq('id', id);
    } else if (action === 'unpublish') {
      await db(admin).from('posts').update({ published: false }).eq('id', id);
    }
  }
  return Astro.redirect('/admin/posts');
}

const { data: posts, error } = await db(admin)
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false });

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<AdminLayout title="Blog Posts" breadcrumb="posts">
  <div class="page-header">
    <h1 class="page-title">Blog Posts</h1>
    <a href="/admin/posts/new" class="btn-primary" style="text-decoration: none;">+ New post</a>
  </div>

  {error && (
    <div class="error-alert">{error.message}</div>
  )}

  {(!posts || posts.length === 0) && (
    <div class="empty-state">
      <div class="empty-state-icon">◻</div>
      <p class="empty-state-text">No posts yet. Start writing your first article.</p>
      <a href="/admin/posts/new" class="btn-primary" style="text-decoration: none;">Write first post</a>
    </div>
  )}

  {posts && posts.length > 0 && (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Date</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr>
              <td>
                <div style="font-size: 0.855rem; font-weight: 600; color: var(--text-strong); margin-bottom: 3px;">{post.title}</div>
                <div style="font-size: 0.68rem; color: var(--text-muted); font-family: var(--font-mono);">/blog/{post.slug}</div>
              </td>
              <td>
                <span class={`badge ${post.published ? 'badge-published' : 'badge-draft'}`}>
                  {post.published ? 'published' : 'draft'}
                </span>
              </td>
              <td style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); white-space: nowrap;">
                {formatDate(post.created_at)}
              </td>
              <td style="text-align: right;">
                <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: nowrap;">
                  {post.published ? (
                    <form method="POST" style="display: contents;">
                      <input type="hidden" name="_action" value="unpublish" />
                      <input type="hidden" name="id" value={post.id} />
                      <button type="submit" class="btn-secondary btn-sm">
                        Unpublish
                      </button>
                    </form>
                  ) : (
                    <form method="POST" style="display: contents;">
                      <input type="hidden" name="_action" value="publish" />
                      <input type="hidden" name="id" value={post.id} />
                      <button type="submit" class="btn-primary btn-sm">
                        Publish
                      </button>
                    </form>
                  )}
                  <a href={`/admin/posts/${post.id}`} class="btn-secondary btn-sm" style="text-decoration: none;">
                    Edit
                  </a>
                  <form method="POST" onsubmit="return confirm('Delete this post?')" style="display: contents;">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={post.id} />
                    <button type="submit" class="btn-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
