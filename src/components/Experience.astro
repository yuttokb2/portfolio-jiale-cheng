---
import ExperienceTimeline from './ExperienceTimeline';

interface Props {
  title: string;
  jobs: {
    date: string;
    title: string;
    company: string;
    description: string;
    tags: string[];
    current?: boolean;
  }[];
}

const { title, jobs } = Astro.props;
---

<section class="relative py-20 px-4" id="experiencia">
  <div class="max-w-3xl mx-auto">

    <p class="fade-up text-center font-mono text-xs tracking-widest uppercase text-cyan-500 mb-3">
      Career
    </p>

    <h2 class="fade-up text-3xl md:text-4xl font-bold mb-4 text-center">
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-white to-cyan-400">
        {title}
      </span>
    </h2>

    <p class="fade-up text-slate-500 text-center max-w-xl mx-auto mb-14 text-sm">
      Building at the intersection of machine learning, data engineering, and real-world impact
    </p>

    <ExperienceTimeline client:visible jobs={jobs} />

  </div>
</section>
